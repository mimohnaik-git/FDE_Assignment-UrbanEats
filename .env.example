URBANEATS_MODEL_DIR=artifacts/model
URBANEATS_RUNS_DIR=runs
URBANEATS_SOURCE_FILE=data/current_batch.json
URBANEATS_MAX_AGE_SECONDS=3600
URBANEATS_MIN_SUPPORT=20
URBANEATS_HOTSPOT_RATE=0.30
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata
# Optional formatter only; TEST_MODE blocks hosted calls. No credential is configured.
LLM_API_KEY=

TEST_MODE=true
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
# LLM_PROVIDER=groq selects these variables; generic LLM_API_KEY is never used for Groq.
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=
# Set to exact image/digest of your existing n8n; do not migrate using latest.
N8N_IMAGE=
